      "id": "0230aaba-aae6-467b-b9dd-2c4ddb0f190f",
      "name": "Read/Write Files from Disk"
    },
    {
      "parameters": {
        "command": "=INPUT=\"/tmp/workfile\"\nOUTPUT=\"/tmp/cleaned_file\"\nSTATUS=\"cleaned\"\n\n# 1. Identify File Type\nEXT=$(exiftool -s3 -FileType \"${INPUT}\" | tr '[:upper:]' '[:lower:]')\n\n# 2. Run the correct command ONE time based on type\nif [[ \"$EXT\" == \"pdf\" || \"$EXT\" == \"docx\" || \"$EXT\" == \"xlsx\" ]]; then\n    # NUCLEAR SCRUB: Documents\n    # 2>/dev/null suppresses error text from clogging n8n\n    exiftool -all= -o \"${OUTPUT}\" \"${INPUT}\" 2>/dev/null || true\n\nelif [[ \"$EXT\" == \"jpeg\" || \"$EXT\" == \"jpg\" || \"$EXT\" == \"png\" || \"$EXT\" == \"tiff\" ]]; then\n    # SMART SCRUB: Images (Preserve Color/Rotation)\n    exiftool -all= -TagsFromFile @ -ColorSpaceTags -Orientation -o \"${OUTPUT}\" \"${INPUT}\" 2>/dev/null || true\n\nelif [[ \"$EXT\" == \"mp4\" || \"$EXT\" == \"mov\" || \"$EXT\" == \"m4v\" ]]; then\n    # VIDEO SCRUB: Target stubborn dates, ignore minor errors\n    exiftool -all= -CreateDate= -ModifyDate= -TrackCreateDate= -MediaCreateDate= \\\n    -AndroidVersion= -o \"${OUTPUT}\" \"${INPUT}\" 2>/dev/null || true\n\nelse\n    # EVERYTHING ELSE (EPUB, ZIP, etc.)\n    # Try a generic scrub. If it's an EPUB/ZIP, this will fail silently.\n    exiftool -all= -o \"${OUTPUT}\" \"${INPUT}\" 2>/dev/null || true\nfi\n\n# 3. The \"Self-Healing\" Check\n# If ExifTool failed (e.g., EPUB/ZIP), the OUTPUT file won't exist.\nif [ ! -f \"${OUTPUT}\" ]; then\n    # Fallback: Copy the original file so the user gets *something* back\n    cp \"${INPUT}\" \"${OUTPUT}\"\n    # Update status so frontend knows to show the warning\n    STATUS=\"unsupported\"\nfi\n\n# 4. Return JSON\necho \"{\\\"status\\\": \\\"$STATUS\\\"}\""
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [320, -208],
